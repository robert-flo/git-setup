#!/usr/bin/env bash

# Managed Git configuration command module.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  set -Eeuo pipefail

  module_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  # shellcheck disable=SC1091 # Resolved from the project root.
  source "$module_dir/../helper/set_variable.sh"
  PROJECT_DIR="$GIT_SETUP_RUNTIME_DIR"

  # shellcheck disable=SC1091 # Resolved from the checked-out project root.
  source "$PROJECT_DIR/lib/presentation.sh"
  # shellcheck disable=SC1091 # Configuration capability used by this command.
  source "$PROJECT_DIR/lib/configuration.sh"
  # shellcheck disable=SC1091 # Focused command interface helper.
  source "$PROJECT_DIR/lib/command_interface.sh"
fi

show_config_help() {
  print_section "Git Configuration Usage"
  cat << 'HELP_EOF'
  Usage: git-setup config [--help]

  Create or refresh the six generated Git configuration files and install the
  managed workflow commands. The optional gitconfig.local file is preserved.
HELP_EOF
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  run_command_entrypoint config show_config_help generate_git_config_files "$@"
fi
